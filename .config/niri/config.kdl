// niri config — hyprland.lua 와 동작을 최대한 똑같이 맞춘 것.
// 다른 점은 niri 구조상 어쩔 수 없는 것뿐 (타일링이 dwindle 이 아니라 컬럼 스크롤, 오프닝 popin 애니메이션 없음).

environment {
    XDG_SESSION_TYPE "wayland"
    XMODIFIERS "@im=fcitx"
    GTK_IM_MODULE "fcitx"
    QT_IM_MODULE "fcitx"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    MOZ_ENABLE_WAYLAND "1"
}

cursor {
    xcursor-size 24
}

input {
    keyboard {
        xkb {
            layout "us"
        }
    }
    // Hyprland 기본값과 맞춤: 탭 클릭 켜짐, 타이핑 중 터치패드 끔, 자연 스크롤 끔
    touchpad {
        tap
        dwt
        accel-speed -0.75
    }
    mouse {
        accel-speed -0.75
    }
    focus-follows-mouse
}

// refresh-rate.sh 가 배터리일 때 60Hz, AC 일 때 120Hz 로 바꾼다.
output "eDP-1" {
    mode "2880x1920@120"
    scale 1.67
    position x=0 y=0
}

// hyprland 의 고정 워크스페이스 1~9 + special:hidden
workspace "1"
workspace "2"
workspace "3"
workspace "4"
workspace "5"
workspace "6"
workspace "7"
workspace "8"
workspace "9"
workspace "hidden"

layout {
    gaps 8
    center-focused-column "never"

    // Hyprland 처럼 새 창은 전체 너비로 연다. Super+R 로 1/3 → 1/2 → 2/3 → 전체 순환.
    default-column-width { proportion 1.0; }
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    focus-ring {
        off
    }

    border {
        width 2
        active-gradient from="#58a6ffee" to="#bc8cffee" angle=45
        inactive-color "#30363d"
    }

    // decoration.shadow.enabled = false
    shadow {
        off
    }
}

prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

overview {
    backdrop-color "#0d1117"
}

// decoration.blur: size 4, passes 1, xray false
blur {
    passes 1
    offset 4
}

// decoration: rounding 10, inactive_opacity 0.75, blur
window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
    // 반투명 창 뒤에 보더 그라데이션이 깔려 비치는 것을 막는다.
    draw-border-with-background false
    background-effect {
        blur true
        xray false
    }
}

window-rule {
    match is-active=false
    opacity 0.75
}

// hide-gateway-stub
window-rule {
    match app-id=r#"^jetbrains-gateway$"# title=r#"^Gateway to .*"#
    open-on-workspace "hidden"
    open-focused false
}

// animations (hyprland speed N = N*100ms)
animations {
    window-open {
        duration-ms 400
        curve "cubic-bezier" 0.23 1 0.32 1
    }
    window-close {
        duration-ms 300
        curve "linear"
    }
    window-movement {
        duration-ms 400
        curve "cubic-bezier" 0.23 1 0.32 1
    }
    window-resize {
        duration-ms 400
        curve "cubic-bezier" 0.23 1 0.32 1
    }
    horizontal-view-movement {
        duration-ms 400
        curve "cubic-bezier" 0.23 1 0.32 1
    }
    workspace-switch {
        duration-ms 400
        curve "cubic-bezier" 0.23 1 0.32 1
    }
}

spawn-sh-at-startup "dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP"
spawn-at-startup "/usr/lib/polkit-kde-authentication-agent-1"
spawn-at-startup "fcitx5"
spawn-at-startup "qs"
spawn-sh-at-startup "awww-daemon & for _ in $(seq 50); do awww query >/dev/null 2>&1 && break; sleep 0.1; done; awww img ~/.config/wp.png"
spawn-at-startup "/home/kr-dev/.config/niri/scripts/refresh-rate.sh"
spawn-at-startup "kitty"

binds {
    Mod+Q { spawn "kitty"; }
    Mod+E { spawn "nautilus"; }
    Mod+C { close-window; }
    Mod+V { toggle-window-floating; }
    Mod+F { fullscreen-window; }
    Mod+Tab { toggle-overview; }

    Mod+Alt+V { spawn "vesktop" "--enable-features=VaapiVideoDecodeLinuxGL,VaapiIgnoreDriverChecks"; }
    Mod+Alt+E { spawn "nautilus"; }
    Mod+Alt+W { spawn "google-chrome-stable"; }
    Mod+Space { spawn "qs" "ipc" "call" "shell" "launcher"; }
    Mod+End { spawn-sh "grim -g \"$(slurp)\" -t png - | wl-copy -t image/png"; }
    Mod+L { spawn-sh "BRV=$(brightnessctl get) && brightnessctl set 75% && hyprlock && brightnessctl set $BRV"; }

    // Quickshell drawers
    Mod+D { spawn "qs" "ipc" "call" "shell" "dashboard"; }
    Mod+X { spawn "qs" "ipc" "call" "shell" "session"; }

    // Quickshell 의 OSD 가 실제 볼륨/밝기 변화에 반응하므로 키는 값만 바꾼다.
    XF86AudioRaiseVolume  allow-when-locked=true { spawn-sh "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"; }
    XF86AudioMute         allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "qs" "ipc" "call" "shell" "brightness" "up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "qs" "ipc" "call" "shell" "brightness" "down"; }

    // 방향키: 좌우는 컬럼, 상하는 창 → 끝에 닿으면 위/아래 워크스페이스로
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-or-workspace-up; }
    Mod+Down  { focus-window-or-workspace-down; }

    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up-or-to-workspace-up; }
    Mod+Shift+Down  { move-window-down-or-to-workspace-down; }


    // ───────── niri 고유 기능 (Hyprland 키와 겹치지 않는 자리) ─────────

    // 워크스페이스 (세로)
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }
    Mod+Shift+Page_Down { move-column-to-workspace-down; }
    Mod+Shift+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+Shift+Up   { move-workspace-up; }
    Mod+Ctrl+Shift+Down { move-workspace-down; }

    // 컬럼 크기
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+M { maximize-column; }
    Mod+Shift+F { expand-column-to-available-width; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // 컬럼 구성
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }
    Mod+W { toggle-column-tabbed-display; }
    Mod+Ctrl+C { center-column; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    // 오버뷰
    Mod+O { toggle-overview; }

    // 마우스 휠
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Shift+WheelScrollDown { focus-column-right; }
    Mod+Shift+WheelScrollUp   { focus-column-left; }

    // niri 내장 스크린샷 (Super+End 의 grim/slurp 와 별개)
    Mod+Insert { screenshot; }
    Mod+Ctrl+Insert { screenshot-screen; }
    Mod+Alt+Insert { screenshot-window; }

    // 세션
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Shift+E { quit; }
    Mod+Shift+P { power-off-monitors; }
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
}
