{
	// 왼쪽 섬: 커널 + 워크스페이스 + 태스크바
	"group/island-left": {
		"orientation": "horizontal",
		"modules": [
			"custom/system",
			"hyprland/workspaces",
			"wlr/taskbar"
		]
	},

	// 가운데 섬: 시계
	"group/island-center": {
		"orientation": "horizontal",
		"modules": [
			"clock"
		]
	},

	// 오른쪽 섬: 상태 표시 + 트레이
	"group/island-right": {
		"orientation": "horizontal",
		"modules": [
			"custom/updates",
			"tray",
			"pulseaudio",
			"network",
			"cpu",
			"memory",
			"battery"
		]
	}
}
