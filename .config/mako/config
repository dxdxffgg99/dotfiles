# mako - flat, hairline style to match the Quickshell drawers (GitHub Dark Colorblind palette)

sort=-time
layer=overlay
anchor=top-right
outer-margin=20

width=380
height=220
padding=18
margin=8

background-color=#010409F7
text-color=#f0f6fc
border-size=1
border-radius=0
border-color=#30363dFF
progress-color=over #58a6ffFF

icons=1
max-icon-size=40

markup=1
actions=1
default-timeout=6000
ignore-timeout=0

font=JetBrainsMono Nerd Font 11
format=<span foreground='#9198a1' letter_spacing='2000'>%a</span>\n%s\n<span foreground='#c9d1d9'>%b</span>

on-button-left=dismiss
on-button-right=dismiss-all
on-button-middle=invoke-default-action
on-touch=dismiss

[urgency=low]
default-timeout=3000

[urgency=critical]
border-color=#f0883eFF
default-timeout=0

[mode=do-not-disturb]
invisible=1
