{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": {
            "top": 3
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "key": "╭───────────╮",
            "type": "custom"
        },
        {
            "type": "command",
            "key": "│ {#31}󱦟  os age {#keys}│",
            "text": "printf \"\\e[0m%s days\\e[0m\" \"$(( ($(date +%s) - $(stat -c %W /)) / 86400 ))\""
        },
        {
            "key": "│ {#33}󰅐  uptime {#keys}│",
            "type": "uptime"
        },
        {
            "key": "│ {#36}{icon}  distro {#keys}│",
            "type": "os"
        },
        {
            "key": "│ {#35}  kernel {#keys}│",
            "type": "kernel"
        },
        {
            "key": "│ {#34}  wm     {#keys}│",
            "type": "wm"
        },
        {
            "key": "│ {#36}󰇄  desktop{#keys}│",
            "type": "de"
        },
        {
            "key": "│ {#39}  term   {#keys}│",
            "type": "terminal"
        },
        {
            "key": "│ {#31}󰍛  cpu    {#keys}│",
            "type": "cpu"
        },
        {
            "key": "│ {#33}󰢮  gpu    {#keys}│",
            "type": "gpu"
        },
        {
            "key": "│ {#34}󰉉  disk   {#keys}│",
            "type": "disk",
            "folders": "/"
        },
        {
            "key": "│ {#32}  memory {#keys}│",
            "type": "memory"
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│ {#39}  colors {#keys}│",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "╰───────────╯",
            "type": "custom"
        }
    ]
}